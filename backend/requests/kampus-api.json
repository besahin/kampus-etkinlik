{
  "info": {
    "name": "Kampüs API",
    "description": "Sprint 8 — Kampüs Etkinlikleri REST API istekleri (MongoDB)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "eventId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1 Health",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "pm.test('status ok ve student var', () => {",
              "  const body = pm.response.json();",
              "  pm.expect(body.status).to.eql('ok');",
              "  pm.expect(body.student).to.eql('2416501054');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:3000/health",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "3000",
          "path": [
            "health"
          ]
        }
      },
      "response": []
    },
    {
      "name": "2 Etkinlik listesi",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "pm.test('en az 6 kayıt (seed sonrası 6)', () => pm.expect(pm.response.json().length).to.be.at.least(6));",
              "pm.test('kayıtlarda _id ve createdAt var', () => {",
              "  const first = pm.response.json()[0];",
              "  pm.expect(first).to.have.property('_id');",
              "  pm.expect(first).to.have.property('createdAt');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:3000/events",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "3000",
          "path": [
            "events"
          ]
        }
      },
      "response": []
    },
    {
      "name": "3 Tek etkinlik",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Listeden gerçek bir _id alıp {{eventId}} değişkenine koyar (kopyalamaya gerek kalmaz)",
              "pm.sendRequest('http://localhost:3000/events', (err, res) => {",
              "  const list = res && res.json();",
              "  if (!err && Array.isArray(list) && list.length > 0) pm.collectionVariables.set('eventId', list[0]._id);",
              "});"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "pm.test('_id istekteki ile aynı', () => pm.expect(pm.response.json()._id).to.eql(pm.collectionVariables.get('eventId')));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:3000/events/{{eventId}}",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "3000",
          "path": [
            "events",
            "{{eventId}}"
          ]
        }
      },
      "response": []
    },
    {
      "name": "4 Olmayan id (404)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('404 Not Found', () => pm.response.to.have.status(404));",
              "pm.test('error.message var', () => pm.expect(pm.response.json().error.message).to.eql('Event not found'));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:3000/events/111111",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "3000",
          "path": [
            "events",
            "111111"
          ]
        }
      },
      "response": []
    },
    {
      "name": "5 Geçerli biçimde ama kayıtsız id (404)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('404 Not Found', () => pm.response.to.have.status(404));",
              "pm.test('error.message var', () => pm.expect(pm.response.json().error.message).to.eql('Event not found'));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:3000/events/507f1f77bcf86cd799439011",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "3000",
          "path": [
            "events",
            "507f1f77bcf86cd799439011"
          ]
        }
      },
      "response": []
    },
    {
      "name": "6 Etkinlik oluştur (201)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201 Created', () => pm.response.to.have.status(201));",
              "pm.test('_id ve createdAt döner', () => {",
              "  const body = pm.response.json();",
              "  pm.expect(body._id).to.be.a('string');",
              "  pm.expect(body.createdAt).to.be.a('string');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "http://localhost:3000/events",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "3000",
          "path": [
            "events"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Kodlama Maratonu\",\n  \"category\": \"Atölye\",\n  \"date\": \"2026-12-22\",\n  \"capacity\": 40,\n  \"time\": \"10:00\",\n  \"location\": \"Bilgisayar Laboratuvarı 2\",\n  \"description\": \"Takımlar halinde 6 saatlik kodlama yarışı.\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
    },
    {
      "name": "7 Eksik veri (400)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('400 Bad Request', () => pm.response.to.have.status(400));",
              "pm.test('error.message var', () => pm.expect(pm.response.json().error.message).to.be.a('string'));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "http://localhost:3000/events",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "3000",
          "path": [
            "events"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Sadece başlık\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
    }
  ]
}
